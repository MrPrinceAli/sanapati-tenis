# Wajib di produksi: string acak minimal 32 karakter (mis. `openssl rand -hex 32`)
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- Database ---------------------------------------------------------------
# Kosong  = file SQLite lokal di ./data (development, atau server dengan disk sendiri)
# Diisi   = Turso. WAJIB di Vercel/serverless karena sistem file-nya read-only.
# TURSO_DATABASE_URL=libsql://nama-db-akunmu.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# --- Akun admin pertama (hanya dipakai saat database masih kosong) -----------
# Di produksi JANGAN biarkan kosong: kalau kosong, password acak dibuat dan hanya muncul sekali di log server.
# ADMIN_EMAIL=admin@sanapati.id
# ADMIN_PASSWORD=password-yang-kuat

# --- Foto unggahan (galeri & foto profil) -----------------------------------
# Otomatis terisi di Vercel begitu Blob store dihubungkan ke project. Tanpa ini foto disimpan ke ./data/uploads.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Opsional ---------------------------------------------------------------
# APP_URL=https://sanapati-tenis.vercel.app   # dipakai di link reset password
# RESEND_API_KEY=re_xxx                         # aktifkan email reset password (resend.com)
# MAIL_FROM="Sanapati Tenis Club <no-reply@domainmu.id>"
# SEED_DEMO=1                                   # isi pemain & booking contoh juga di produksi (untuk demo saja)
# DATA_DIR=/var/lib/sanapati                    # lokasi file SQLite + upload bila tidak memakai Turso
